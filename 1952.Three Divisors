import math
class Solution(object):
    def isThree(self, n):

        if n<4:
            return False
       
#A number has exactly 3 positive divisors if it is the square of a prime number.
        root=math.sqrt(n)
        if root == int(root):

            isprime=True
            for i in range(2,int(math.sqrt(root))+1):
                if int(root) % i==0:
                    isprime=False
                    break
            if isprime :
                return True
        return False


