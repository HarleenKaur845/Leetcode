class Solution(object):
    def isValid(self, s):
        stack=[]
        for ch in s:
            if ch=="(" or ch=="[" or ch=="{":
                stack.append(ch)
            else:
                if stack:
                    Top=stack[-1]
                    if Top=="(" and ch==")":
                        stack.pop()
                    elif Top=="{" and ch=="}":
                        stack.pop()
                    elif Top=="[" and ch=="]":
                        stack.pop()
                    else:
                        return False
                else:
                    return False
        return len(stack)==0
