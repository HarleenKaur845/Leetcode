class Solution(object):
    def searchRange(self, nums, target):
        result=[]
    # Binary search for first index
        low=0
        high=len(nums)-1
        ans=-1
        while low <= high:
            mid=(low + high)//2

            if nums[mid]==target:
                ans= mid
                high=mid-1
            elif nums[mid] < target:
                low = mid + 1

            else:
                high = mid - 1
        result.append(ans)
        #Binary search for last idx   

        low=0
        high=len(nums)-1
        ans=-1
        while low <= high:
            mid=(low + high)//2

            if nums[mid]==target:
                ans= mid
                low=mid+1
            elif nums[mid] < target:
                low = mid + 1

            else:
                high = mid - 1
            
        result.append(ans)
        return result
        

            

            
